{
    "name": "dashboard",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/dashboard/src",
    "projectType": "application",
    "targets": {
        "serve": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run dev",
                "cwd": "apps/dashboard"
            }
        },
        "build": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run build",
                "cwd": "apps/dashboard"
            }
        },
        "build-image": {
            "executor": "nx:run-commands",
            "options": {
                "command": "docker build --platform linux/amd64 -t nqh44/spotary-dashboard:{args.ver} .",
                "cwd": "apps/dashboard",
                "forwardAllArgs": false
            }
        },
        "push-image": {
            "executor": "nx:run-commands",
            "options": {
                "command": "docker push nqh44/spotary-dashboard:{args.ver}",
                "cwd": "apps/dashboard",
                "forwardAllArgs": false
            }
        }
    },
    "tags": [
        "type:frontend"
    ]
}