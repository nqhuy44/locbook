{
  "name": "admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/admin/src",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev",
        "cwd": "apps/admin"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run build",
        "cwd": "apps/admin"
      }
    },
    "prebuild-image": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mv .env ../../temp/admin.env || true",
        "cwd": "apps/admin"
      }
    },
    "postbuild-image": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mv ../../temp/admin.env .env || true",
        "cwd": "apps/admin"
      }
    },
    "build-image": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build --platform linux/amd64 --build-arg VITE_API_URL=$VITE_API_URL --build-arg VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID -t nqh44/spotary-admin:{args.ver} .",
        "cwd": "apps/admin",
        "forwardAllArgs": false
      }
    },
    "push-image": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker push nqh44/spotary-admin:{args.ver}",
        "cwd": "apps/admin",
        "forwardAllArgs": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run lint",
        "cwd": "apps/admin"
      }
    }
  },
  "tags": ["type:frontend", "scope:admin"]
}
